# --- Registry: LOCAL (Verdaccio) ---
# Alternate npm config for testing against a local Verdaccio registry
# instead of the real one.
#
# For PUBLISHING: don't copy this over .npmrc by hand -- `npm run
# publish:local` already passes `--userconfig .npmrc.verdaccio` plus an
# explicit `--@lynkflow:registry=http://localhost:4873` override, which is
# required precisely because the committed .npmrc's scoped
# `@lynkflow:registry` mapping otherwise wins over a bare `--registry` flag
# (or even `--userconfig` alone) for scoped packages -- this is what caused
# `npm run publish:local` to actually publish to the real GitHub Packages
# registry on 11 Aug 2026. See publishing.md's "Local registry (Verdaccio)"
# section for the full incident note.
#
# For INSTALLING/consuming against Verdaccio instead: use `npm run
# install:local` -- it passes the same kind of scope-specific CLI override
# as publish:local, no .npmrc swap needed (a plain install doesn't have
# publishConfig fighting it the way publish does, so the CLI flag alone is
# enough).
@lynkflow:registry=http://localhost:4873

# Verdaccio's @lynkflow/* scope allows anonymous publish/unpublish
# (tools/verdaccio/config.yaml) -- but npm's own CLI still refuses to even
# attempt `npm publish` unless SOME auth token is configured for the target
# registry, regardless of whether the server would actually check it. This
# isn't a real credential (Verdaccio never validates it under $anonymous),
# it exists purely to satisfy that client-side check -- confirmed by
# reproduction: identical setup fails with ENEEDAUTH with no token line at
# all, succeeds with this placeholder present. Don't run `npm adduser`
# for this -- it writes to your real ~/.npmrc, which --userconfig
# .npmrc.verdaccio never even reads.
//localhost:4873/:_authToken=anonymous-local-only
install-links=true
