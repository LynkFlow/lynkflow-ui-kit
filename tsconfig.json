{
  "extends": "@lynkflow/config/tsconfig/library.json",
  "compilerOptions": {
    /* library.json already sets: module/moduleResolution "nodenext",
       target "esnext", strict, noUncheckedIndexedAccess,
       exactOptionalPropertyTypes, verbatimModuleSyntax, isolatedModules,
       moduleDetection "force", declaration, declarationMap, sourceMap,
       skipLibCheck, ignoreDeprecations "6.0" (tsup --dts / TS5101 — see
       tooling.md). Everything below is what's specific to THIS repo:
       React, and this repo's own strictness/output choices. */

    /* React */
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],

    /* Output */
    "rootDir": "src",

    /* noUncheckedSideEffectImports is deliberately NOT in the shared base --
       lynkflow-mfe-template needs it off (see its tsconfig for why); this
       repo keeps it on. Genuinely per-repo, not a candidate to centralize. */
    "noUncheckedSideEffectImports": true,

    /* Test globals only — keeps the many transitive @types/* packages
       (node, jsdom, istanbul-*, yargs, ...) that Jest and its deps pull
       in from leaking into this browser-target library's global scope.
       "types" only resolves packages published under node_modules/@types
       (typeRoots) — @testing-library/jest-dom ships its own bundled
       types instead, so its matcher augmentation (toBeInTheDocument(),
       etc.) is pulled in via a plain import in src/test/jest-dom.d.ts,
       not listed here. */
    "types": ["jest"]
  },

  "include": ["src"]
}
